{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "tray"],
  "permissions": [
    "core:app:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://ahooks.js.org/*"
        },
        {
          "url": "https://github.com/NeserCode-Studio/ailicili*"
        },
        {
          "url": "https://react.dev/*"
        },
        {
          "url": "https://reactrouter.com/*"
        },
        {
          "url": "https://tailwindcss.com/*"
        },
        {
          "url": "https://tauri.app/*"
        },
        {
          "url": "https://ui.shadcn.com/*"
        },
        {
          "url": "https://vite.dev/*"
        },
        {
          "url": "https://www.typescriptlang.org/*"
        },
        {
          "url": "https://zod.dev/*"
        }
      ]
    },
    "core:window:allow-get-all-windows",
    "core:window:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-always-on-bottom",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-focused",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-is-visible",
    "core:app:allow-default-window-icon",
    "core:event:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*.tauri.app"
        },
        {
          "url": "https://*.hdslb.com/**"
        },
        {
          "url": "https://*.douyinpic.com/**"
        },
        {
          "url": "https://huyaimg.msstatic.com/**"
        },
        {
          "url": "https://anchorpost.msstatic.com/**"
        },
        {
          "url": "https://live-cover.msstatic.com/**"
        }
      ],
      "deny": [
        {
          "url": "https://private.tauri.app"
        }
      ]
    },
    "http:default",
    "core:tray:default",
    "core:tray:allow-new",
    "core:resources:default",
    "core:resources:allow-close"
  ]
}
