{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ailicili",
  "version": "1.0.0-beta.1",
  "identifier": "com.nesercode.ailicili",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:8888",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ailicili",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "visible": true,
        "focus": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-accelerated-video-decode"
      },
      {
        "label": "tray",
        "url": "/tray",
        "title": "Tray Menu",
        "skipTaskbar": true,
        "decorations": false,
        "dragDropEnabled": false,
        "center": false,
        "visible": false,
        "resizable": false,
        "width": 220,
        "height": 280,
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-accelerated-video-decode"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "homepage": "https://github.com/NeserCode-Studio/ailicili",
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
